# Copy to .env.docker; always pass --env-file .env.docker to Compose.
# Local-only access (base compose.yaml):
APP_PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Public reverse proxy hostname, without scheme or path:
DOMAIN=transport.example.com
# Match your EXISTING Traefik deployment:
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_ROUTER=traquantopassa
# Leave empty when certificates are configured on the Traefik entrypoint.
TRAEFIK_CERT_RESOLVER=

API_BASE_URL=https://app-tpl.tndigit.it
# Optional overrides; blank values use the built-in bus API credentials.
API_USERNAME=
API_PASSWORD=
GOATCOUNTER_URL=
GOATCOUNTER_API_KEY=
APP_MEMORY_LIMIT=512m
APP_CPUS=1.0
