{
	"name": "traquantopassa",
	"version": "2.0.0",
	"private": true,
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node -r dotenv/config build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"check-updates": "pnpm dlx npm-check-updates -i --format group,repo --cooldown 1d",
		"check-updates-semver": "pnpm dlx npm-check-updates -i --format group,repo --cooldown 1d --target semver",
		"test": "vitest run --reporter=tree",
		"test:dev": "vitest",
		"smoke": "node scripts/smoke.mjs",
		"test:browser": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.58.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/eslint": "^9.6.1",
		"@types/node": "^24.0.0",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.55.10",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.3.0",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.64.0",
		"vite": "^8.3.1",
		"vitest": "^4.1.7",
		"@tailwindcss/vite": "^4.3.1"
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@lucide/svelte": "^1.21.0",
		"cheerio": "^1.2.0",
		"dotenv": "^17.4.2",
		"topbar": "^3.0.1"
	},
	"packageManager": "pnpm@12.6.0"
}
