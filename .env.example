# Runtime settings; never commit real credentials.
PUBLIC_BASE_URL=http://localhost:3000
ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000

# Required for bus pages.
API_BASE_URL=https://app-tpl.tndigit.it
# Optional overrides; blank values use the built-in bus API credentials.
API_USERNAME=
API_PASSWORD=

# Optional: leave both empty to disable analytics and use fallback rankings.
GOATCOUNTER_URL=
GOATCOUNTER_API_KEY=

# Behind a trusted reverse proxy only, after configuring it to overwrite this header:
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
